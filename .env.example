# ArabMorph AI — environment template. Copy to .env and fill in; never commit .env.
# Phase 1 (engine only) reads no environment variables. The entries below are
# placeholders for later phases and are documented here so the names stay stable.

# Phase 3–4: Django / PostgreSQL
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# DATABASE_URL=postgres://arabmorph:password@localhost:5432/arabmorph

# Phase 6: background jobs
# REDIS_URL=redis://localhost:6379/0

# Phase 7: AI providers (optional — the engine works without them)
# AI_PROVIDER=none
# AI_API_KEY=
