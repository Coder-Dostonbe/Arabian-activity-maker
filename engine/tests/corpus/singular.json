     "expected_vocalized": {"nominative": ["الْقَاضِي"], "accusative": ["الْقَاضِيَ"], "genitive": ["الْقَاضِي"]}},

    {"id": "maqsur-01", "category": "maqsur, indefinite", "word": "فتى", "lexicon": "seed", "state": "indefinite", "rule": "decl.maqsur", "status": "ok", "ref": "G",
